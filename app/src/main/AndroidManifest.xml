<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".MarkActivity" android:exported="false"
            android:windowSoftInputMode="stateVisible|adjustResize" />
        <activity android:name=".SummaryActivity" android:exported="false" />
        <activity android:name=".AdminActivity" android:exported="false" />
        <activity android:name=".WorkersActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".HistoryActivity" android:exported="false" />

        <provider
            android:name=".PhotoProvider"
            android:authorities="pe.ecocentury.asistencia.fotos"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
